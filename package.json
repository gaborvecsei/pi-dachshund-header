{
	"name": "pi-dachshund-header",
	"version": "0.1.0",
	"description": "A tail-wagging dachshund startup header for the pi coding agent. Draw your own pet in plain text.",
	"type": "module",
	"license": "MIT",
	"author": "Gabor Vecsei",
	"keywords": [
		"pi-package",
		"pi-extension",
		"header",
		"dachshund",
		"pet",
		"ascii-art"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gaborvecsei/pi-dachshund-header.git"
	},
	"files": [
		"extensions",
		"pets",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/dachshund-header.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run typecheck"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@earendil-works/pi-tui": "^0.85.1",
		"@types/node": "^24.7.2",
		"typescript": "^5.9.3"
	}
}
